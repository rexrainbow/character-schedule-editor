{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Schedule Environment Schema",
  "type": "object",
  "required": [
    "format_version",
    "environment",
    "settings",
    "operand_nodes",
    "tasks"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "environment": {
      "$ref": "#/$defs/environment_info"
    },
    "settings": {
      "$ref": "#/$defs/project_settings"
    },
    "operand_nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operand_node"
      }
    },
    "expression_macros": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression_macro"
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/task_definition"
      }
    },
    "builtin_tasks": {
      "type": "object",
      "properties": {
        "set_variable": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "increment_variable": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "random_amplitude": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "toggle_variable": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "reset_variable": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "schedule_takeover": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "adjust_probability_event": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "icon": {
              "type": "string"
            },
            "engine_key": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "property": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "operation": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "display_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "enum_definitions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/enum_definition_node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "environment_info": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_settings": {
      "type": "object",
      "required": [
        "slots_per_day"
      ],
      "properties": {
        "slots_per_day": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "operand_node": {
      "oneOf": [
        {
          "$ref": "#/$defs/group_node"
        },
        {
          "$ref": "#/$defs/value_node"
        }
      ]
    },
    "group_node": {
      "type": "object",
      "required": [
        "display_name",
        "parent_id",
        "order",
        "node_type"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "node_type": {
          "const": "group"
        },
        "scope": {
          "const": "environment"
        },
        "engine_key": {
          "type": "string",
          "description": "Optional engine contract name. Duplicate nonempty keys warn in the editor but do not invalidate the project."
        },
        "icon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "value_node": {
      "type": "object",
      "required": [
        "display_name",
        "parent_id",
        "order",
        "node_type",
        "value_type",
        "read_only"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "node_type": {
          "const": "value"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "read_only": {
          "type": "boolean",
          "default": false
        },
        "scope": {
          "const": "environment"
        },
        "engine_key": {
          "type": "string",
          "description": "Optional engine contract name. Duplicate nonempty keys warn in the editor but do not invalidate the project."
        },
        "icon": {
          "type": "string"
        },
        "initial_value": {
          "type": [
            "number",
            "string",
            "boolean"
          ],
          "description": "Constant initial value. When omitted, defaults to 0, empty string or false according to value_type."
        },
        "min_value": {
          "type": "number",
          "description": "Optional inclusive numeric bound. Runtime clamps numeric writes to the configured bounds. Omitted means unrestricted."
        },
        "max_value": {
          "type": "number",
          "description": "Optional inclusive numeric bound. Runtime clamps numeric writes to the configured bounds. Omitted means unrestricted."
        },
        "integer_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "initial_value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "initial_value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "initial_value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min_value"
                  ]
                },
                {
                  "required": [
                    "max_value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "integer_only"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "integer_only": {
                "const": true
              }
            },
            "required": [
              "integer_only"
            ]
          },
          "then": {
            "properties": {
              "initial_value": {
                "type": "integer"
              },
              "min_value": {
                "type": "integer"
              },
              "max_value": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "expression_macro": {
      "type": "object",
      "required": [
        "display_name",
        "value_type",
        "definition"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "number",
            "boolean"
          ]
        },
        "definition": {
          "$ref": "#/$defs/computed_definition"
        },
        "engine_key": {
          "type": "string",
          "description": "Optional engine contract name. Duplicate nonempty keys warn in the editor but do not invalidate the project."
        },
        "icon": {
          "type": "string"
        },
        "scope": {
          "const": "environment"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "properties": {
                  "kind": {
                    "enum": [
                      "number",
                      "branch"
                    ]
                  },
                  "branches": {
                    "items": {
                      "properties": {
                        "result": {
                          "properties": {
                            "kind": {
                              "const": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "properties": {
                  "kind": {
                    "enum": [
                      "boolean",
                      "branch"
                    ]
                  },
                  "branches": {
                    "items": {
                      "properties": {
                        "result": {
                          "properties": {
                            "kind": {
                              "const": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "computed_definition": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar_computed_definition"
        },
        {
          "$ref": "#/$defs/branched_computed_definition"
        }
      ]
    },
    "scalar_computed_definition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "expression": {
              "$ref": "#/$defs/numeric_operand"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "numeric_operand": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "reference_id"
          ],
          "properties": {
            "type": {
              "const": "reference"
            },
            "reference_id": {
              "$ref": "#/$defs/uuid"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "constant"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/expression_operand"
        },
        {
          "$ref": "#/$defs/expression_macro_reference"
        },
        {
          "$ref": "#/$defs/event_property_operand"
        }
      ]
    },
    "expression_operand": {
      "type": "object",
      "required": [
        "type",
        "operator",
        "operand_a",
        "operand_b"
      ],
      "properties": {
        "type": {
          "const": "expression"
        },
        "operator": {
          "type": "string",
          "enum": [
            "+",
            "-",
            "*",
            "/"
          ]
        },
        "operand_a": {
          "$ref": "#/$defs/numeric_operand"
        },
        "operand_b": {
          "$ref": "#/$defs/numeric_operand"
        }
      },
      "additionalProperties": false
    },
    "expression_macro_reference": {
      "type": "object",
      "required": [
        "type",
        "expression_macro_id"
      ],
      "properties": {
        "type": {
          "const": "expression_macro_reference"
        },
        "expression_macro_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "event_property_operand": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event_property"
        },
        "event": {
          "$ref": "#/$defs/event_argument"
        },
        "property": {
          "enum": [
            "probability_percent",
            "cooldown_days",
            "cooldown_remaining"
          ]
        }
      },
      "required": [
        "type",
        "event",
        "property"
      ],
      "additionalProperties": false
    },
    "event_argument": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_reference"
        },
        {
          "$ref": "#/$defs/current_event_reference"
        },
        {
          "$ref": "#/$defs/parameter_reference_operand"
        }
      ]
    },
    "event_reference": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event_reference"
        },
        "event_group_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "type",
        "event_group_id"
      ],
      "additionalProperties": false
    },
    "current_event_reference": {
      "type": "object",
      "properties": {
        "type": {
          "const": "current_event_reference"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "parameter_reference_operand": {
      "type": "object",
      "required": [
        "type",
        "parameter_id"
      ],
      "properties": {
        "type": {
          "const": "parameter_reference"
        },
        "parameter_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/conditionGroup"
        },
        {
          "$ref": "#/$defs/conditionComparison"
        }
      ]
    },
    "conditionGroup": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "group"
        },
        "mode": {
          "enum": [
            "ALL",
            "ANY"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "additionalProperties": false
    },
    "conditionComparison": {
      "type": "object",
      "required": [
        "kind",
        "operand_a",
        "comparator",
        "operand_b"
      ],
      "properties": {
        "operand_a": {
          "$ref": "#/$defs/operand"
        },
        "comparator": {
          "type": "string",
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "operand_b": {
          "$ref": "#/$defs/operand"
        },
        "kind": {
          "const": "comparison"
        }
      },
      "additionalProperties": false
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference_operand"
        },
        {
          "$ref": "#/$defs/constant_operand"
        },
        {
          "$ref": "#/$defs/expression_operand"
        },
        {
          "$ref": "#/$defs/expression_macro_reference"
        },
        {
          "$ref": "#/$defs/event_property_operand"
        }
      ]
    },
    "reference_operand": {
      "type": "object",
      "required": [
        "type",
        "reference_id"
      ],
      "properties": {
        "type": {
          "const": "reference"
        },
        "reference_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "constant_operand": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "constant"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "branched_computed_definition": {
      "type": "object",
      "required": [
        "kind",
        "branches"
      ],
      "properties": {
        "kind": {
          "const": "branch"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/computed_branch"
          },
          "contains": {
            "type": "object",
            "required": [
              "condition"
            ],
            "properties": {
              "condition": {
                "type": "null"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "additionalProperties": false
    },
    "computed_branch": {
      "type": "object",
      "required": [
        "condition",
        "result"
      ],
      "properties": {
        "condition": {
          "oneOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/scalar_computed_definition"
        }
      },
      "additionalProperties": false
    },
    "task_definition": {
      "type": "object",
      "required": [
        "display_name",
        "parameters"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_parameter"
          }
        },
        "engine_key": {
          "type": "string",
          "description": "Optional engine contract name. Duplicate nonempty keys warn in the editor but do not invalidate the project."
        },
        "icon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "task_parameter": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "variable_reference",
            "event_reference",
            "enum"
          ]
        },
        "value_type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "any"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        },
        "event_kind": {
          "enum": [
            "any",
            "probability"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "display_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$"
              }
            },
            "required": [
              "display_name",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "enum_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "variable_reference"
              }
            }
          },
          "then": {
            "required": [
              "value_type",
              "access"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value_type"
                  ]
                },
                {
                  "required": [
                    "access"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "event_reference"
              }
            }
          },
          "then": {
            "required": [
              "event_kind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "event_kind"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "not": {
                  "required": [
                    "enum_id"
                  ]
                }
              },
              {
                "required": [
                  "enum_id"
                ],
                "not": {
                  "required": [
                    "options"
                  ]
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "enum_id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "enum_definition_node": {
      "type": "object",
      "properties": {
        "node_type": {
          "enum": [
            "group",
            "enum"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string"
        },
        "engine_key": {
          "type": "string"
        },
        "scope": {
          "const": "environment"
        },
        "parent_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuid"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "display_name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$"
              }
            },
            "required": [
              "display_name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "node_type",
        "display_name",
        "scope",
        "parent_id",
        "order"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    }
  }
}
