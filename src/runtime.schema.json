{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Schedule Runtime Data Schema",
  "description": "Runtime data v1. References, types, dependency contracts, ELSE ordering, scopes and cell counts also require compiler validation.",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "display_name": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "slots_per_day": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "slots_per_day"
      ],
      "additionalProperties": false
    },
    "environment_requirements": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable_requirement"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_requirement"
          }
        },
        "environment": {
          "$ref": "#/$defs/environment_info"
        }
      },
      "required": [
        "variables",
        "tasks"
      ],
      "additionalProperties": false
    },
    "environment_variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_variable_tree"
      }
    },
    "application_variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable_tree"
      }
    },
    "expression_macros": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_expression"
      }
    },
    "task_macros": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_macro"
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_slot"
      }
    },
    "days": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_day"
      }
    },
    "weeks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_week"
      }
    },
    "sequences": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtime_sequence"
      }
    },
    "exports": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "operands",
              "expressions",
              "taskMacros",
              "slots",
              "days",
              "weeks",
              "sequences"
            ]
          },
          "id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "display_name",
    "settings",
    "environment_requirements",
    "environment_variables",
    "application_variables",
    "expression_macros",
    "task_macros",
    "slots",
    "days",
    "weeks",
    "sequences",
    "exports"
  ],
  "additionalProperties": false,
  "$defs": {
    "variable_requirement": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "engine_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value_type": {
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "read_only": {
          "type": "boolean"
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        }
      },
      "required": [
        "display_name",
        "engine_key",
        "value_type",
        "read_only",
        "access"
      ],
      "additionalProperties": false
    },
    "task_requirement": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "engine_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_parameter_requirement"
          }
        }
      },
      "required": [
        "display_name",
        "engine_key",
        "parameters"
      ],
      "additionalProperties": false
    },
    "runtime_parameter_requirement": {
      "type": "object",
      "required": [
        "display_name",
        "type"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "variable_reference",
            "expression"
          ]
        },
        "value_type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "any"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "variable_reference"
              }
            }
          },
          "then": {
            "required": [
              "value_type",
              "access"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value_type"
                  ]
                },
                {
                  "required": [
                    "access"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "environment_info": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "environment_variable_tree": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "group"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/environment_variable_tree"
              }
            }
          },
          "required": [
            "display_name",
            "id",
            "kind",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "value"
            },
            "value_type": {
              "enum": [
                "number",
                "string",
                "boolean"
              ]
            },
            "read_only": {
              "type": "boolean"
            },
            "initial_value": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          },
          "required": [
            "display_name",
            "id",
            "kind",
            "value_type",
            "read_only",
            "initial_value",
            "engine_key"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "number"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "boolean"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "boolean"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "variable_tree": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "group"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/variable_tree"
              }
            }
          },
          "required": [
            "display_name",
            "id",
            "kind",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "value"
            },
            "value_type": {
              "enum": [
                "number",
                "string",
                "boolean"
              ]
            },
            "read_only": {
              "type": "boolean"
            },
            "initial_value": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          },
          "required": [
            "display_name",
            "id",
            "kind",
            "value_type",
            "read_only",
            "initial_value"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "number"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "value_type": {
                    "const": "boolean"
                  }
                }
              },
              "then": {
                "properties": {
                  "initial_value": {
                    "type": "boolean"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "runtime_expression": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "engine_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value_type": {
          "enum": [
            "number",
            "boolean"
          ]
        },
        "definition": {
          "$ref": "#/$defs/computed_definition"
        }
      },
      "required": [
        "display_name",
        "value_type",
        "definition"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "properties": {
                  "kind": {
                    "enum": [
                      "number",
                      "branch"
                    ]
                  },
                  "branches": {
                    "items": {
                      "properties": {
                        "result": {
                          "properties": {
                            "kind": {
                              "const": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "properties": {
                  "kind": {
                    "enum": [
                      "boolean",
                      "branch"
                    ]
                  },
                  "branches": {
                    "items": {
                      "properties": {
                        "result": {
                          "properties": {
                            "kind": {
                              "const": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "computed_definition": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar_computed_definition"
        },
        {
          "$ref": "#/$defs/branched_computed_definition"
        }
      ]
    },
    "scalar_computed_definition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "expression": {
              "$ref": "#/$defs/numeric_operand"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "numeric_operand": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "reference_id"
          ],
          "properties": {
            "type": {
              "const": "reference"
            },
            "reference_id": {
              "$ref": "#/$defs/uuid"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "constant"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/expression_operand"
        },
        {
          "$ref": "#/$defs/expression_macro_reference"
        },
        {
          "$ref": "#/$defs/environment_reference"
        }
      ]
    },
    "expression_operand": {
      "type": "object",
      "required": [
        "type",
        "operator",
        "operand_a",
        "operand_b"
      ],
      "properties": {
        "type": {
          "const": "expression"
        },
        "operator": {
          "type": "string",
          "enum": [
            "+",
            "-",
            "*",
            "/"
          ]
        },
        "operand_a": {
          "$ref": "#/$defs/numeric_operand"
        },
        "operand_b": {
          "$ref": "#/$defs/numeric_operand"
        }
      },
      "additionalProperties": false
    },
    "expression_macro_reference": {
      "type": "object",
      "required": [
        "type",
        "expression_macro_id"
      ],
      "properties": {
        "type": {
          "const": "expression_macro_reference"
        },
        "expression_macro_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "environment_reference": {
      "type": "object",
      "properties": {
        "type": {
          "const": "environment_reference"
        },
        "engine_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "engine_key"
      ],
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/conditionGroup"
        },
        {
          "$ref": "#/$defs/conditionComparison"
        }
      ]
    },
    "conditionGroup": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "group"
        },
        "mode": {
          "enum": [
            "ALL",
            "ANY"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "additionalProperties": false
    },
    "conditionComparison": {
      "type": "object",
      "required": [
        "kind",
        "operand_a",
        "comparator",
        "operand_b"
      ],
      "properties": {
        "operand_a": {
          "$ref": "#/$defs/operand"
        },
        "comparator": {
          "type": "string",
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "operand_b": {
          "$ref": "#/$defs/operand"
        },
        "kind": {
          "const": "comparison"
        }
      },
      "additionalProperties": false
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference_operand"
        },
        {
          "$ref": "#/$defs/constant_operand"
        },
        {
          "$ref": "#/$defs/expression_operand"
        },
        {
          "$ref": "#/$defs/expression_macro_reference"
        },
        {
          "$ref": "#/$defs/environment_reference"
        }
      ]
    },
    "reference_operand": {
      "type": "object",
      "required": [
        "type",
        "reference_id"
      ],
      "properties": {
        "type": {
          "const": "reference"
        },
        "reference_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "constant_operand": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "constant"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "branched_computed_definition": {
      "type": "object",
      "required": [
        "kind",
        "branches"
      ],
      "properties": {
        "kind": {
          "const": "branch"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/computed_branch"
          },
          "contains": {
            "type": "object",
            "required": [
              "condition"
            ],
            "properties": {
              "condition": {
                "type": "null"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "additionalProperties": false
    },
    "computed_branch": {
      "type": "object",
      "required": [
        "condition",
        "result"
      ],
      "properties": {
        "condition": {
          "oneOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/scalar_computed_definition"
        }
      },
      "additionalProperties": false
    },
    "runtime_macro": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/task_parameter"
              }
            },
            "mode": {
              "const": "sequence"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/runtime_step"
              }
            }
          },
          "required": [
            "display_name",
            "parameters",
            "mode",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "engine_key": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/task_parameter"
              }
            },
            "mode": {
              "const": "branch"
            },
            "branches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/runtime_branch"
              }
            }
          },
          "required": [
            "display_name",
            "parameters",
            "mode",
            "branches"
          ],
          "additionalProperties": false
        }
      ]
    },
    "task_parameter": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "variable_reference"
          ]
        },
        "value_type": {
          "enum": [
            "number",
            "string",
            "boolean",
            "any"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "variable_reference"
              }
            }
          },
          "then": {
            "required": [
              "value_type",
              "access"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value_type"
                  ]
                },
                {
                  "required": [
                    "access"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "runtime_step": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtime_task"
        },
        {
          "$ref": "#/$defs/runtime_assignment"
        },
        {
